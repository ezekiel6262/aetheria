{
  "name": "aetheria",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A persistent autonomous digital world on X Layer where AI agents live, play, create, and evolve.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "compile": "node contracts/scripts/compile.mjs",
    "deploy:xlayer": "node contracts/scripts/compile.mjs && node contracts/scripts/deploy.mjs",
    "test": "node --test server/world.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "openai": "^4.104.0"
  },
  "devDependencies": {
    "solc": "0.8.26"
  }
}
